# Copy to .env and replace every value. Never commit .env.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=drphynex
POSTGRES_USER=drphynex
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

# Must match the values above when using Docker locally.
DATABASE_URL=postgres://drphynex:change-me-local-only@127.0.0.1:5433/drphynex

# --- Payload ---
# Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public origin of the site (no trailing slash). Used for CORS/CSRF and hreflang.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Deployment services (leave unset locally: uploads stay on disk, emails go to the console) ---
# See docs/deployment-plan.md. Set these in Vercel per environment (Production / Preview), never in Git.

# Object storage, S3 API (Cloudflare R2 or AWS S3). Bucket must stay private.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_CLIENT_UPLOADS=false

# Outgoing email over SMTP (form notifications). Port 465 = TLS, 587 = STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Dr.PhynEX website
# Where new contact / B2B notifications are sent (comma-separated). The email contains no form data.
# FORM_NOTIFY_TO=
