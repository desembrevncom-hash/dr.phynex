# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files: only the template is versioned. Every real environment
# (.env, .env.local, .env.staging, .env.production, .env.preview, *.local …) stays local.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/media

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Payload uploads (local disk storage)
/private-uploads


# Brand source files, internal documents, mockups and review screenshots (not committed).
# Web-ready public assets that the build needs live in public/brand/ and ARE committed.
/brand-assets

# Machine-specific AI/agent tooling and local settings (no file here is versioned).
/.claude/
/.agents/
/.codex/
